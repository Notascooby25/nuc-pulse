[Unit]
Description=NUC Pulse Server Sanity Dashboard
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/.venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8520
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
